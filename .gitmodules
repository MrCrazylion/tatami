[submodule "deps/libsolv"]
	path = deps/libsolv
	url = https://github.com/openSUSE/libsolv.git
	ignore = untracked
[submodule "deps/zlib"]
	path = deps/zlib
	url = https://github.com/madler/zlib.git
	ignore = untracked
[submodule "deps/zstd"]
	path = deps/zstd
	url = https://github.com/facebook/zstd.git
	ignore = untracked
[submodule "deps/libarchive"]
	path = deps/libarchive
	url = https://github.com/libarchive/libarchive.git
	ignore = untracked
[submodule "deps/xz"]
	path = deps/xz
	url = https://github.com/tukaani-project/xz.git
	ignore = untracked
[submodule "deps/lz4"]
	path = deps/lz4
	url = https://github.com/lz4/lz4.git
	ignore = untracked
[submodule "deps/bzip2"]
	path = deps/bzip2
	url = https://gitlab.com/bzip2/bzip2.git
	ignore = untracked
[submodule "deps/libsodium"]
	path = deps/libsodium
	url = https://github.com/jedisct1/libsodium.git
	ignore = untracked
