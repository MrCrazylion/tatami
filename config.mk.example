# Copy to config.mk to set build-time options without typing them on every make
# command line. The command line still wins over this file.
#
# Where 'make install' puts things (they are not compiled in):
#PREFIX     = /usr
#
# Where tatami looks for its files at run time, below the root given with --root.
# These ARE compiled in (as TATAMI_SYSCONFDIR, TATAMI_DB_DIR, TATAMI_CACHEDIR),
# and 'make install' uses the same places. Must be absolute paths.
#SYSCONFDIR = /etc
#DB_DIR     = /var/lib/tatami
#CACHEDIR   = /var/cache/tatami
#
# A fixed package extension for tatami and tatamk (default: tar.<compression>)
#PKG_EXT    =
#
# Plain '=' here overrides the environment; use '?=' to let the environment win.
